{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm --prefix apps/dovesoft-web install",
  "buildCommand": "npm --prefix apps/dovesoft-web run build",
  "outputDirectory": "apps/dovesoft-web/dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
