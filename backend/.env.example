# ──── JWT (for Express auth) ────
JWT_SECRET=your-jwt-secret

# ──── Server ────
PORT=5000

# ──── WhatsApp Master Admin ────
# Master login bypasses all checks. Use this to create/manage users.
WHATSAPP_MASTER_EMAIL=admin@whatsapp.com
WHATSAPP_MASTER_PASSWORD=Admin123!

# ──── WhatsApp Cloud API (Meta) ────
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-access-token
WHATSAPP_API_VERSION=v23.0
WHATSAPP_WABA_ID=your-waba-id
WHATSAPP_VERIFY_TOKEN=ucscompany123

# ──── WhatsApp Templates ────
WHATSAPP_TEMPLATE_NAME=bsct_receipt

# ──── Admin Seed ────
ADMIN_EMAIL=admin@ufs.com
ADMIN_PASSWORD=123456

# ──── Optional: OCR, Firebase, Groq, Razorpay, IMAP, Paytm ────
# OCR_SPACE_KEY=
# GROQ_API_KEY=
# FIREBASE_PROJECT_ID=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_CLIENT_EMAIL=
# IMAP_ENABLED=false
# RAZORPAY_ENABLED=false
# PAYTM_ENABLED=false

# ──── Optional: Live Google Sheets report (quiz results) ────
# GOOGLE_SHEET_ID=your-spreadsheet-id
# GOOGLE_SHEET_NAME=Sheet1
# For deployment, pass the service account JSON inline (prefer base64, e.g.:
#   $env:GOOGLE_SERVICE_ACCOUNT = [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
# raw inline JSON also works:
# GOOGLE_SERVICE_ACCOUNT={"type":"service_account",...}
# For local dev you may instead use a file path:
# GOOGLE_SERVICE_ACCOUNT=credentials/service-account.json
