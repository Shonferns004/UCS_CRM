# Copy to `.env` and adjust. `.env` is git-ignored; this file is not.
#
# Base URL of the backend API, including the /api prefix and no trailing slash.
# The variable is read in src/api.js -- note the name is VITE_API_URL.
#
# Leave unset to use production:
VITE_API_URL=https://api.beingsevak.org/api

# For local development against a backend running on this machine
# (node src/index.js in ../backend, which listens on 5000):
# VITE_API_URL=http://localhost:5000/api
