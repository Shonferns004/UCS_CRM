# ===== Supabase (required) =====
# Project URL and keys from: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Vite reads these in the frontend folder (sevak library/.env)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ===== Admin login (for the staff panel) =====
ADMIN_EMAIL=admin@sevaklibrary.org
ADMIN_PASSWORD=ChangeMe-12345

# ===== Email (Gmail SMTP) for membership/payment emails =====
# Sends FROM GMAIL_USER via smtp.gmail.com:465 using an App Password.
# Create one at https://myaccount.google.com/apppasswords (needs 2-Step Verification).
GMAIL_USER=library.sevak@gmail.com
GMAIL_APP_PASSWORD=
