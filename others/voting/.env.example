# Where the API lives. In production the booth is served by the same Express app
# that owns the API, so an empty value is correct and requests go to /api/voting.
# Set this only when running `npm run dev` against a backend on another host.
VITE_API_URL=

# Realtime origin for socket.io. Defaults to the API origin with /api stripped.
VITE_SOCKET_URL=
