<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Debug-only launch entry point.
         The release manifest puts the MAIN/LAUNCHER filter on the .LauncherAlias
         activity-alias so LauncherToggler can hide the icon without disabling
         MainActivity (the secret-code receiver and notifications still need it).
         The Flutter tool resolves a launch activity by scanning <activity>
         elements only and ignores <activity-alias>, so `flutter run` would fail
         with "package identifier or launch activity not found".

         Adding the filter to MainActivity here — and only here, via build-type
         manifest merging — gives the tool a launchable component while leaving
         release and profile builds with the hidden-icon behaviour intact.
         MainActivity is never disabled by LauncherToggler, so this stays
         launchable for the whole debug session.
    -->
    <application>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            tools:node="merge">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
