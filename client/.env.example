# ──── API Backend ────
# Points to your Express backend (local or deployed)
VITE_API_URL=https://3-6-189-66.sslip.io/api

# ──── Realtime Socket ────
# Socket.io server URL (optional; defaults to VITE_API_URL with /api stripped)
VITE_SOCKET_URL=https://3-6-189-66.sslip.io

# ──── Community Chat ────
# true  = in-memory demo data (client/src/components/chat/chatMock.js)
# false = real backend: GET/POST /api/chat/* + the socket.io chat namespace
#
# Fails safe: chatApi.js enables the mock only when this is exactly "true", so
# leaving it unset talks to the real backend. It used to be `!== 'false'`, which
# meant an ABSENT value turned the mock ON - that shipped demo users like
# "Priya Nair" and their invented replies to production.
#
# Leave it unset (or false) for any real deployment. The backend must be running
# AND have /api/chat mounted.
# VITE_CHAT_MOCK=false

